# Secrets — never commit
backend/.env
.env

# Sample data IS committed so a clone has something to work with. Excluded:
# SQLite sidecar files (transient) and the crop cache (derived, and keyed on
# source path, so it regenerates itself).
backend/storage/drape.db-wal
backend/storage/drape.db-shm
backend/storage/crops/

# Environments and build output
backend/.venv/
frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store

# Internal reference — contains account ids, client references and credential
# locations that must not reach the public repo.
INTERNAL.md
