# Copy to backend/.env and fill in. That file is gitignored — never commit real values.

# --- Generation provider ------------------------------------------------------
# The account and session every generation runs under. The session id is a
# capability rather than a label: anyone holding it can spend the associated
# account's credits, so treat it like a credential.
DRAPE_PROVIDER_ORG_ID=
DRAPE_PROVIDER_PROJECT_ID=
DRAPE_PROVIDER_ENTITY_ID=
DRAPE_PROVIDER_SESSION_ID=

# --- Generation backend -------------------------------------------------------
base_url=
access_token=
refresh_token=
access_key=

# --- Vision (analysis + QC) ---------------------------------------------------
# Google Gemini. A key on the free tier rate-limits at around 20 requests a
# minute, which a batch analysis run reaches almost immediately.
GEMINI_API_KEY_AISTUDIO=

# --- Paths --------------------------------------------------------------------
# Directory containing the shared generation client module. Required to generate.
DRAPE_SHARED_UTILS=

# Optional: an extra directory the file server may read images from, so garments
# can be referenced where they already sit rather than copied into the app.
DRAPE_ALLOWED_ROOT=

# Optional: an additional credentials file, loaded last, for setups where the
# generation credentials are managed outside this repo.
DRAPE_EXTRA_ENV=

# Optional: source manifest for import_examples.py
DRAPE_EXAMPLE_MANIFEST=
