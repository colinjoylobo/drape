# Copy to backend/.env and fill in. This file is gitignored — never commit real values.

# --- Generation routing -------------------------------------------------------
# The session ID is a capability, not a label: it is the project-entity binding
# that lets this org use Model Garden. Treat it like a credential.
DRAPE_SERVICING_ORG_ID=
DRAPE_SERVICING_PROJECT_ID=
DRAPE_SERVICING_TASK_ENTITY_ID=
DRAPE_SERVICING_TASK_SESSION_ID=

# --- Model garden / generation backend ---------------------------------------
base_url=
access_token=
refresh_token=
access_key=

# --- Vision (analysis + QC) ---------------------------------------------------
GEMINI_API_KEY_AISTUDIO=

# --- Paths --------------------------------------------------------------------
# Directory containing nanobanana_fallback.py (the model-garden client this app
# builds on). Required for generation.
DRAPE_SHARED_UTILS=

# Optional: an extra directory the file server may read images from, so garments
# can be referenced where they already sit rather than copied into the app.
DRAPE_ALLOWED_ROOT=

# Optional: an additional credentials file to load last, for setups where the
# generation credentials are managed outside this repo.
DRAPE_EXTRA_ENV=

# Optional: source manifest for import_examples.py
DRAPE_EXAMPLE_MANIFEST=
